rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.get('admin', false) == true;
    }

    function isPostAuthor() {
      return isSignedIn()
        && resource.data.get('authorUid', '') == request.auth.uid;
    }

    function isCommentAuthor() {
      return isSignedIn()
        && resource.data.get('writerUid', '') == request.auth.uid;
    }

    function isValidPostCreate() {
      let data = request.resource.data;

      return data.keys().hasAll([
          'title',
          'content',
          'postNo',
          'date',
          'category',
          'isNotice',
          'likeCount',
          'likedUsers',
          'authorUid',
          'displayName',
          'photoURL'
        ])
        && data.keys().hasOnly([
          'title',
          'content',
          'postNo',
          'date',
          'category',
          'isNotice',
          'likeCount',
          'likedUsers',
          'authorUid',
          'displayName',
          'photoURL'
        ])
        && data.title is string
        && data.content is string
        && data.postNo is int
        && data.date is timestamp
        && (
          data.category == null
          || data.category is string
        )
        && data.isNotice is bool
        && data.likeCount == 0
        && data.likedUsers is list
        && data.likedUsers.size() == 0
        && data.authorUid == request.auth.uid
        && (
          data.displayName == null
          || data.displayName is string
        )
        && (
          data.photoURL == null
          || data.photoURL is string
        );
    }

    function isValidCommentCreate() {
      let data = request.resource.data;

      return data.keys().hasAll([
          'content',
          'createdAt',
          'likedUsers',
          'likeCount',
          'writerUid',
          'displayName',
          'photoURL'
        ])
        && data.keys().hasOnly([
          'content',
          'createdAt',
          'likedUsers',
          'likeCount',
          'writerUid',
          'displayName',
          'photoURL'
        ])
        && data.content is string
        && data.createdAt is timestamp
        && data.likedUsers is list
        && data.likedUsers.size() == 0
        && data.likeCount == 0
        && data.writerUid == request.auth.uid
        && (
          data.displayName == null
          || data.displayName is string
        )
        && (
          data.photoURL == null
          || data.photoURL is string
        );
    }

    function isValidPostContentUpdate() {
      return isPostAuthor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'content',
          'category',
          'updatedAt'
        ]);
    }

    function isValidCommentContentUpdate() {
      return isCommentAuthor()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['content']);
    }

    function isValidLikeCreate() {
      return isSignedIn()
        && request.resource.data.keys().hasAll(['likeCount', 'likedUsers'])
        && request.resource.data.keys().hasOnly(['likeCount', 'likedUsers'])
        && request.resource.data.likeCount == 1
        && request.resource.data.likedUsers is list
        && request.resource.data.likedUsers.size() == 1
        && request.resource.data.likedUsers[0] == request.auth.uid;
    }

    function isValidLikeUpdate() {
      let previousCount = resource.data.get('likeCount', 0);
      let previousUsers = resource.data.get('likedUsers', []);
      let nextCount = request.resource.data.get('likeCount', 0);
      let nextUsers = request.resource.data.get('likedUsers', []);
      let addedUsers = nextUsers.toSet().difference(previousUsers.toSet());
      let removedUsers = previousUsers.toSet().difference(nextUsers.toSet());

      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likeCount', 'likedUsers'])
        && nextCount is int
        && nextCount >= 0
        && nextUsers is list
        && nextUsers.size() == nextUsers.toSet().size()
        && (
          (
            addedUsers.size() == 1
            && addedUsers.hasOnly([request.auth.uid])
            && removedUsers.size() == 0
            && nextCount == previousCount + 1
          )
          || (
            removedUsers.size() == 1
            && removedUsers.hasOnly([request.auth.uid])
            && addedUsers.size() == 0
            && nextCount == previousCount - 1
          )
        );
    }

    function isValidViewCountUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['viewCount'])
        && request.resource.data.viewCount is int
        && request.resource.data.viewCount
          == resource.data.get('viewCount', 0) + 1;
    }

    function isValidSavedTrack() {
      return request.resource.data.keys().hasAll([
          'id',
          'title',
          'artist',
          'artworkUrl',
          'permalinkUrl',
          'durationMs',
          'genre',
          'tags',
          'savedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'title',
          'artist',
          'artworkUrl',
          'permalinkUrl',
          'durationMs',
          'genre',
          'tags',
          'savedAt'
        ])
        && (
          request.resource.data.id is int
          || request.resource.data.id is string
        )
        && request.resource.data.title is string
        && request.resource.data.artist is string
        && (
          request.resource.data.artworkUrl == null
          || request.resource.data.artworkUrl is string
        )
        && (
          request.resource.data.permalinkUrl == null
          || request.resource.data.permalinkUrl is string
        )
        && (
          request.resource.data.durationMs is int
          || request.resource.data.durationMs is float
        )
        && request.resource.data.durationMs >= 0
        && request.resource.data.genre is string
        && request.resource.data.tags is list
        && request.resource.data.savedAt is timestamp;
    }

    function hasOnlyAllowedPostFields() {
      return request.resource.data.keys().hasOnly([
        'title',
        'content',
        'postNo',
        'date',
        'category',
        'isNotice',
        'likeCount',
        'likedUsers',
        'viewCount',
        'authorUid',
        'displayName',
        'photoURL',
        'updatedAt'
      ]);
    }

    function hasOnlyAllowedCommentFields() {
      return request.resource.data.keys().hasOnly([
        'content',
        'createdAt',
        'likedUsers',
        'likeCount',
        'writerUid',
        'displayName',
        'photoURL'
      ]);
    }

    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read, update, delete: if isOwner(userId);

      match /savedTracks/{trackId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidSavedTrack();
      }
    }

    match /free/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidPostCreate()
        && (
          request.resource.data.get('isNotice', false) == false
          || isAdmin()
        );
      allow update: if hasOnlyAllowedPostFields()
        && (
          isValidPostContentUpdate()
          || isAdmin()
          || isValidLikeUpdate()
          || isValidViewCountUpdate()
        );
      allow delete: if isPostAuthor() || isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && exists(
            /databases/$(database)/documents/free/$(postId)
          )
          && isValidCommentCreate();
        allow update: if exists(
            /databases/$(database)/documents/free/$(postId)
          )
          && hasOnlyAllowedCommentFields()
          && (
            isValidCommentContentUpdate()
            || isAdmin()
            || isValidLikeUpdate()
          );

        // 부모 글이 삭제돼도 본인 댓글은 삭제할 수 있음
        allow delete: if isCommentAuthor() || isAdmin();
      }
    }

    match /notice/{postId} {
      allow read: if true;
      allow create: if isAdmin()
         && isValidPostCreate()
        && request.resource.data.isNotice == true;
      allow update: if hasOnlyAllowedPostFields()
        && (
          isAdmin()
          || isValidLikeUpdate()
          || isValidViewCountUpdate()
        );
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && exists(
          /databases/$(database)/documents/notice/$(postId)
        )
         && isValidCommentCreate();
        allow update: if exists(
            /databases/$(database)/documents/notice/$(postId)
          )
          && hasOnlyAllowedCommentFields()
          && (
            isValidCommentContentUpdate()
          || isAdmin()
          || isValidLikeUpdate()
        );

        allow delete: if isCommentAuthor() || isAdmin();
      }
    }

    match /pet/{postId} {
      allow read: if true;
      allow create: if isValidLikeCreate();
      allow update: if isValidLikeUpdate();
    }

    // collectionGroup("comments")로 본인 댓글을 조회할 때 필요합니다.
    // 쓰기는 위의 free/notice 하위 경로에서만 허용합니다.
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

  }
}
