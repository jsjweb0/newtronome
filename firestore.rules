rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.get('admin', false) == true;
    }

    function isNextPostNumber(boardType, postId) {
      let counterPath =
        /databases/$(database)/documents/postCounters/$(boardType);
      let current = get(counterPath).data.current;
      let next = getAfter(counterPath).data.current;

      return current is int
        && next is int
        && next == current + 1
        && postId == string(next);
    }

    function isValidCounterUpdate(boardType) {
      let next = request.resource.data.current;
      let nextPostId = string(next);

      return isSignedIn()
        && (
          boardType == 'free'
          || (boardType == 'notice' && isAdmin())
        )
        && resource.data.keys().hasOnly(['current'])
        && request.resource.data.keys().hasOnly(['current'])
        && resource.data.current is int
        && next is int
        && next == resource.data.current + 1
        && !exists(
          /databases/$(database)/documents/$(boardType)/$(nextPostId)
        )
        && existsAfter(
          /databases/$(database)/documents/$(boardType)/$(nextPostId)
        );
    }

    function isPostAuthor() {
      return isSignedIn()
        && resource.data.get('authorUid', '') == request.auth.uid;
    }

    function isCommentAuthor() {
      return isSignedIn()
        && resource.data.get('writerUid', '') == request.auth.uid;
    }

    function isValidText(value, maxLength) {
      return value is string
        && value.trim().size() > 0
        // RE2의 각 Unicode 문자를 한 글자로 바꿔 JS 코드 포인트 계산과 맞춘다.
        && value.replace('(?s).', 'x').size() <= maxLength;
    }

    function isValidCategory(boardType, value) {
      return boardType == 'free'
        ? value in ['chat', 'quote', 'recommendation', 'question']
        : value == null;
    }

    function isValidChangedPostInputs(boardType) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let data = request.resource.data;
      return (!changed.hasAny(['title']) || isValidText(data.get('title', null), 100))
        && (!changed.hasAny(['content']) || isValidText(data.get('content', null), 10000))
        && (!changed.hasAny(['category']) || isValidCategory(boardType, data.get('category', null)));
    }

    function isValidChangedCommentInputs() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['content'])
        || isValidText(request.resource.data.get('content', null), 1000);
    }

    function isValidProfileCreate() {
      let data = request.resource.data;
      return !data.keys().hasAny(['nickname']) || isValidText(data.nickname, 8);
    }

    function isValidProfileUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['nickname'])
        || isValidText(request.resource.data.get('nickname', null), 8);
    }

    function isValidPostCreate(boardType) {
      let data = request.resource.data;

      return data.keys().hasAll([
          'title',
          'content',
          'date',
          'category',
          'isNotice',
          'likeCount',
          'likedUsers',
          'authorUid',
          'displayName',
          'photoURL'
        ])
        && data.keys().hasOnly([
          'title',
          'content',
          'date',
          'category',
          'isNotice',
          'likeCount',
          'likedUsers',
          'authorUid',
          'displayName',
          'photoURL'
        ])
        && isValidText(data.title, 100)
        && isValidText(data.content, 10000)
        && data.date is timestamp
        && data.date == request.time
        && isValidCategory(boardType, data.category)
        && data.isNotice is bool
        && data.likeCount == 0
        && data.likedUsers is list
        && data.likedUsers.size() == 0
        && data.authorUid == request.auth.uid
        && (
          data.displayName == null
          || data.displayName is string
        )
        && (
          data.photoURL == null
          || data.photoURL is string
        );
    }

    function isValidCommentCreate() {
      let data = request.resource.data;

      return data.keys().hasAll([
          'content',
          'createdAt',
          'likedUsers',
          'likeCount',
          'writerUid',
          'displayName',
          'photoURL'
        ])
        && data.keys().hasOnly([
          'content',
          'createdAt',
          'likedUsers',
          'likeCount',
          'writerUid',
          'displayName',
          'photoURL'
        ])
        && isValidText(data.content, 1000)
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && data.likedUsers is list
        && data.likedUsers.size() == 0
        && data.likeCount == 0
        && data.writerUid == request.auth.uid
        && (
          data.displayName == null
          || data.displayName is string
        )
        && (
          data.photoURL == null
          || data.photoURL is string
        );
    }

    function isValidPostContentUpdate() {
      return isPostAuthor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'content',
          'category',
          'updatedAt'
        ]);
    }

    function isValidCommentContentUpdate() {
      return isCommentAuthor()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['content']);
    }

    function isValidPostAfterUpdate() {
      let data = request.resource.data;
      let viewCount = data.get('viewCount', 0);
      let updatedAt = data.get('updatedAt', null);

      return data.keys().hasAll([
          'title',
          'content',
          'date',
          'category',
          'isNotice',
          'likeCount',
          'likedUsers',
          'authorUid',
          'displayName',
          'photoURL'
        ])
        && hasOnlyAllowedPostFields()
        && data.title is string
        && data.content is string
        && (
          !data.keys().hasAny(['postNo'])
          || data.postNo is int
        )
        && data.date is timestamp
        && (
          data.category == null
          || data.category is string
        )
        && data.isNotice is bool
        && data.likeCount is int
        && data.likeCount >= 0
        && data.likedUsers is list
        && data.authorUid is string
        && (
          data.displayName == null
          || data.displayName is string
        )
        && (
          data.photoURL == null
          || data.photoURL is string
        )
        && viewCount is int
        && viewCount >= 0
        && (
          updatedAt == null
          || updatedAt is string
        );
    }

    function isValidCommentAfterUpdate() {
      let data = request.resource.data;

      return data.keys().hasAll([
          'content',
          'createdAt',
          'likedUsers',
          'likeCount',
          'writerUid',
          'displayName',
          'photoURL'
        ])
        && hasOnlyAllowedCommentFields()
        && data.content is string
        && data.createdAt is timestamp
        && data.likedUsers is list
        && data.likeCount is int
        && data.likeCount >= 0
        && data.writerUid is string
        && (
          data.displayName == null
          || data.displayName is string
        )
        && (
          data.photoURL == null
          || data.photoURL is string
        );
    }

    function isValidLikeCreate() {
      return isSignedIn()
        && request.resource.data.keys().hasAll(['likeCount', 'likedUsers'])
        && request.resource.data.keys().hasOnly(['likeCount', 'likedUsers'])
        && request.resource.data.likeCount == 1
        && request.resource.data.likedUsers is list
        && request.resource.data.likedUsers.size() == 1
        && request.resource.data.likedUsers[0] == request.auth.uid;
    }

    function isValidLikeUpdate() {
      let previousCount = resource.data.get('likeCount', 0);
      let previousUsers = resource.data.get('likedUsers', []);
      let nextCount = request.resource.data.get('likeCount', 0);
      let nextUsers = request.resource.data.get('likedUsers', []);
      let addedUsers = nextUsers.toSet().difference(previousUsers.toSet());
      let removedUsers = previousUsers.toSet().difference(nextUsers.toSet());

      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likeCount', 'likedUsers'])
        && nextCount is int
        && nextCount >= 0
        && nextUsers is list
        && nextUsers.size() == nextUsers.toSet().size()
        && (
          (
            addedUsers.size() == 1
            && addedUsers.hasOnly([request.auth.uid])
            && removedUsers.size() == 0
            && nextCount == previousCount + 1
          )
          || (
            removedUsers.size() == 1
            && removedUsers.hasOnly([request.auth.uid])
            && addedUsers.size() == 0
            && nextCount == previousCount - 1
          )
        );
    }

    function isValidViewCountUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['viewCount'])
        && request.resource.data.viewCount is int
        && request.resource.data.viewCount
          == resource.data.get('viewCount', 0) + 1;
    }

    function isValidSavedTrack() {
      return request.resource.data.keys().hasAll([
          'id',
          'title',
          'artist',
          'artworkUrl',
          'permalinkUrl',
          'durationMs',
          'genre',
          'tags',
          'savedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'title',
          'artist',
          'artworkUrl',
          'permalinkUrl',
          'durationMs',
          'genre',
          'tags',
          'savedAt',
          'playbackStatus',
          'playbackStatusCheckedAt'
        ])
        && (
          request.resource.data.id is int
          || request.resource.data.id is string
        )
        && request.resource.data.title is string
        && request.resource.data.artist is string
        && (
          request.resource.data.artworkUrl == null
          || request.resource.data.artworkUrl is string
        )
        && (
          request.resource.data.permalinkUrl == null
          || request.resource.data.permalinkUrl is string
        )
        && (
          request.resource.data.durationMs is int
          || request.resource.data.durationMs is float
        )
        && request.resource.data.durationMs >= 0
        && request.resource.data.genre is string
        && request.resource.data.tags is list
        && request.resource.data.savedAt is timestamp
        && (
          request.resource.data.keys().hasAny(['playbackStatus'])
          == request.resource.data.keys().hasAny(['playbackStatusCheckedAt'])
        )
        && (
          !request.resource.data.keys().hasAny(['playbackStatus'])
          || (
            request.resource.data.playbackStatus in [
              'allowed',
              'preview',
              'blocked'
            ]
            && request.resource.data.playbackStatusCheckedAt is timestamp
          )
        );
    }

    function isValidSavedPlaylist(playlistId) {
      let data = request.resource.data;

      return data.keys().hasAll(['id', 'title', 'soundCloudUrl', 'savedAt'])
        && data.keys().hasOnly(['id', 'title', 'soundCloudUrl', 'savedAt'])
        && data.id == playlistId
        && data.title is string
        && data.soundCloudUrl is string
        && data.savedAt == request.time;
    }

    function hasOnlyAllowedPostFields() {
      return request.resource.data.keys().hasOnly([
        'title',
        'content',
        'postNo',
        'date',
        'category',
        'isNotice',
        'likeCount',
        'likedUsers',
        'viewCount',
        'authorUid',
        'displayName',
        'photoURL',
        'updatedAt'
      ]);
    }

    function hasOnlyAllowedCommentFields() {
      return request.resource.data.keys().hasOnly([
        'content',
        'createdAt',
        'likedUsers',
        'likeCount',
        'writerUid',
        'displayName',
        'photoURL'
      ]);
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && isValidProfileCreate();
      allow update: if isOwner(userId) && isValidProfileUpdate();
      allow read, delete: if isOwner(userId);

      match /savedTracks/{trackId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidSavedTrack();
      }

      match /savedPlaylists/{playlistId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSavedPlaylist(playlistId);
        allow update: if false;
      }
    }

    match /postCounters/{boardType} {
      allow read: if isSignedIn();
      allow update: if isValidCounterUpdate(boardType);
      allow create, delete: if false;
    }

    match /free/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isNextPostNumber('free', postId)
        && isValidPostCreate('free')
        && (
          request.resource.data.isNotice == false
          || isAdmin()
        );
      allow update: if isValidPostAfterUpdate()
        && isValidChangedPostInputs('free')
        && (
          isValidPostContentUpdate()
          || isAdmin()
          || isValidLikeUpdate()
          || isValidViewCountUpdate()
        );
      allow delete: if isPostAuthor() || isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && exists(
            /databases/$(database)/documents/free/$(postId)
          )
          && isValidCommentCreate();
        allow update: if exists(
            /databases/$(database)/documents/free/$(postId)
          )
          && isValidCommentAfterUpdate()
          && isValidChangedCommentInputs()
          && (
            isValidCommentContentUpdate()
            || isAdmin()
            || isValidLikeUpdate()
          );

        // 부모 글이 삭제돼도 본인 댓글은 삭제할 수 있음
        allow delete: if isCommentAuthor() || isAdmin();
      }
    }

    match /notice/{postId} {
      allow read: if true;
      allow create: if isAdmin()
        && isNextPostNumber('notice', postId)
        && isValidPostCreate('notice');
      allow update: if isValidPostAfterUpdate()
        && isValidChangedPostInputs('notice')
        && (
          isAdmin()
          || isValidLikeUpdate()
          || isValidViewCountUpdate()
        );
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && exists(
          /databases/$(database)/documents/notice/$(postId)
        )
         && isValidCommentCreate();
        allow update: if exists(
            /databases/$(database)/documents/notice/$(postId)
          )
          && isValidCommentAfterUpdate()
          && isValidChangedCommentInputs()
          && (
            isValidCommentContentUpdate()
          || isAdmin()
          || isValidLikeUpdate()
        );

        allow delete: if isCommentAuthor() || isAdmin();
      }
    }

    // collectionGroup("comments")로 본인 댓글을 조회할 때 필요합니다.
    // 쓰기는 위의 free/notice 하위 경로에서만 허용합니다.
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

  }
}
