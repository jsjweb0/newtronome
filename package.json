{
  "name": "newtronome",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:run": "vitest run --environment jsdom src workers",
    "test:rules": "XDG_CONFIG_HOME=/tmp/newtronome-firebase-config FIREBASE_CLI_DISABLE_UPDATE_CHECK=true firebase emulators:exec --only firestore --project demo-newtronome \"vitest run --environment node tests/firestore.rules.test.ts\"",
    "preview": "vite preview",
    "frontend:deploy": "npx wrangler deploy",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --project=a11y-chromium"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@tailwindcss/vite": "^4.1.7",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "firebase": "^11.9.0",
    "lucide-react": "^0.514.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.5",
    "swiper": "^14.3.0",
    "tailwindcss": "^4.1.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.25.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-admin": "^14.4.0",
    "firebase-tools": "^15.30.2",
    "globals": "^16.0.0",
    "jsdom": "^30.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
